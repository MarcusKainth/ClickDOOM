* text=auto eol=lf

# Data, not text. Diffing or merging these is meaningless and normalising line
# endings would corrupt them.
*.wad binary
*.bin binary
*.pkl binary
*.png binary

# Generated by the toolchain container, byte-for-byte reproducible.
rom/build/** binary

# Vendored upstream. Verified against a sha256 manifest, so it must not be
# normalised on checkout.
rom/vendor/** -text
