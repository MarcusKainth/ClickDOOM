<!-- Native server config for B1. native_server.sh fills in @@PATH@@ and the ports. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <log>@@PATH@@/log/clickhouse-server.log</log>
        <errorlog>@@PATH@@/log/clickhouse-server.err.log</errorlog>
        <console>0</console>
    </logger>
    <listen_host>127.0.0.1</listen_host>
    <tcp_port>@@TCP_PORT@@</tcp_port>
    <http_port>@@HTTP_PORT@@</http_port>
    <path>@@PATH@@/data/</path>
    <tmp_path>@@PATH@@/tmp/</tmp_path>
    <user_files_path>@@PATH@@/user_files/</user_files_path>
    <format_schema_path>@@PATH@@/format_schemas/</format_schema_path>
    <users_config>users.xml</users_config>
    <default_profile>default</default_profile>
    <default_database>default</default_database>
    <mark_cache_size>5368709120</mark_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_log>
</clickhouse>
